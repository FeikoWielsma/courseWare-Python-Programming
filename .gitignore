# Recursive patterns for all project types
# Windows
Thumbs.db
Desktop.ini

# Visual Studio / C++ / C#
**/.vs/
**/[Bb]in/
**/[Oo]bj/
**/[Xx]64/
**/[Xx]86/
**/[Dd]ebug/
**/[Rr]elease/
**/*.exe
**/*.pdb
**/*.suo
**/*.user
**/*.userosscache
**/*.sln.doccache
**/packages/
**/*.nupkg

# Java / Eclipse / IntelliJ / VS Code
**/*.class
**/*.jar
**/*.war
**/*.ear
**/.project
**/.classpath
**/.settings/
**/.idea/
**/.vscode/

# Python
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.venv/
**/venv/
**/env/
**/.env

# Rust
**/target/

# Node
**/node_modules/

# Database / System
**/WiredTiger*
**/journal/
**/*.db-journal

# Archives (Only if users want them ignored - let's be aggressive for now)
**/*.zip
**/*.rar
**/*.7z
**/*.gz
**/*.tar


# Presentation-as-Code build outputs
build/dist/
build/.mermaid-cache/
build/spiraltrain-logo.png
node_modules/
__pycache__/
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/

# Built course decks (CI builds these from src/ and publishes them as release
# assets; the original decks live in archive/)
/PRG400-Python-Programming.pdf
/PRG400-Python-Programming.html
/PRG400-Python-Programming-Marp.pdf
/PRG400-Python-Programming-Marp.html
/PRG400-Python-Programming-Exercises.pdf
/PRG400-Python-Programming-Exercises.html
demos/10-python-database-access/*.db
build/site/dist/
exercises/starters/*/uv.lock

# Optional libraries deck build outputs
# Only the maintained scripts are tracked; scratch scripts and QA output stay ignored.
libraries/build/*
!libraries/build/check-demos.py
!libraries/build/check-outputs.py
!libraries/build/check-solutions.py
!libraries/build/check_support.py
!libraries/build/make-data.py
!libraries/build/native_states.py
!libraries/build/slidev.config.ts
libraries/PRG400-Python-Libraries-and-Tools*.pdf
libraries/PRG400-Python-Libraries-and-Tools*.html
libraries/data/*.db
build/slidev/
# Generated work per deck and variant: Slidev apps, PDFs, logs, artifacts.json
.courseware/
build/prototypes/presentation-framework/
