{
  "name": "courseware-python-programming-build",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "bun run toolchain.ts build",
    "serve": "bun run toolchain.ts build --serve",
    "lint": "bun run toolchain.ts lint",
    "slidev": "bun run toolchain.ts slidev",
    "site": "bun run site.ts",
    "toolchain": "bun run toolchain.ts toolchain",
    "pin": "bun run toolchain.ts pin",
    "verify": "bun run toolchain.ts verify",
    "test": "bun test ../tests/site",
    "test:examples": "uv run --project ../libraries python ../tests/libraries/check-demos.py && uv run --project ../libraries python ../tools/libraries/make-data.py --check && uv run --project ../libraries python ../tools/libraries/native_states.py --check",
    "test:animations": "uv run python ../tests/animations/check-examples.py && bun run ../tests/animations/check-delivery.ts",
    "bundle": "bun run toolchain.ts bundle",
    "release": "bun run toolchain.ts release",
    "sync-student": "bun run toolchain.ts sync-student"
  }
}
