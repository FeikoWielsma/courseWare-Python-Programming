{
  "name": "courseware-python-programming-build",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "slidev": "bun run slidev.ts",
    "slidev:compare": "bun run slidev.ts --compare --serve",
    "slidev:pdf": "bun run slidev.ts --pdf",
    "slidev:check": "bun run slidev.ts --check-only",
    "build": "bun run ../../Presentation-Template/build/build.ts",
    "serve": "bun run ../../Presentation-Template/build/build.ts --serve",
    "lint": "bun run ../../Presentation-Template/build/lint-slides.ts",
    "site": "bun run site.config.ts",
    "libraries": "bun run libraries.ts",
    "lint:libraries": "bun run libraries.ts --lint"
  }
}
