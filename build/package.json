{
  "name": "courseware-python-programming-build",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "slidev": "bun run slidev.ts",
    "slidev:compare": "bun run slidev.ts --compare --serve",
    "slidev:pdf": "bun run slidev.ts --pdf",
    "slidev:check": "bun run slidev.ts --check-only",
    "slidev:dev": "bun run slidev.ts --dev",
    "build:marp": "bun run course.ts --marp",
    "serve:marp": "bun run course.ts --marp --serve",
    "check:animations": "uv run python check-slidev-examples.py",
    "check:delivery": "bun run check-slidev-delivery.ts",
    "build": "bun run course.ts",
    "serve": "bun run course.ts --serve",
    "lint": "bun run course.ts --lint",
    "site": "bun run site.config.ts",
    "libraries": "bun run libraries.ts",
    "libraries:marp": "bun run libraries.ts --marp",
    "libraries:serve": "bun run libraries.ts --serve",
    "lint:libraries": "bun run libraries.ts --lint"
  }
}
