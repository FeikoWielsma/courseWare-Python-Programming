{
  "name": "courseware-python-programming-build",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "slidev": "bun run toolchain.ts slidev fundamentals",
    "slidev:compare": "bun run toolchain.ts slidev fundamentals --compare --serve",
    "slidev:pdf": "bun run toolchain.ts slidev fundamentals --pdf",
    "slidev:check": "bun run toolchain.ts slidev fundamentals --check-only",
    "slidev:dev": "bun run toolchain.ts slidev fundamentals --dev",
    "build:marp": "bun run toolchain.ts build fundamentals --marp",
    "serve:marp": "bun run toolchain.ts build fundamentals --marp --serve",
    "check:animations": "uv run python check-slidev-examples.py",
    "check:delivery": "bun run check-slidev-delivery.ts",
    "build": "bun run toolchain.ts build fundamentals",
    "serve": "bun run toolchain.ts build fundamentals --serve",
    "lint": "bun run toolchain.ts build fundamentals --lint",
    "site": "bun run site.ts",
    "libraries": "bun run toolchain.ts build libraries",
    "libraries:marp": "bun run toolchain.ts build libraries --marp",
    "libraries:serve": "bun run toolchain.ts build libraries --serve",
    "lint:libraries": "bun run toolchain.ts build libraries --lint",
    "toolchain": "bun run toolchain.ts toolchain",
    "pin": "bun run toolchain.ts pin",
    "verify": "bun run toolchain.ts verify",
    "test": "bun test toolchain.test.ts site.test.ts",
    "bundle": "bun run toolchain.ts bundle",
    "release": "bun run toolchain.ts release",
    "sync-student": "bun run toolchain.ts sync-student"
  }
}
